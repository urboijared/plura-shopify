{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
<section class="section">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="product-grid">
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_view_all and collection.products_count > limit -%}
        <p style="margin-top: 32px">
          <a class="link-arrow" href="{{ collection.url }}">{{ 'sections.featured_collection.view_all' | t }}</a>
        </p>
      {%- endif -%}
    {%- else -%}
      <ul class="product-grid">
        {%- for i in (1..3) -%}
          <li>
            <article class="card product-card">
              <div class="product-card__media"><div class="placeholder">{% render 'isotipo', width: 72 %}</div></div>
              <div class="product-card__body">
                <h3 class="product-card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
                <p class="product-card__excerpt">{{ 'sections.featured_collection.placeholder_text' | t }}</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Planes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu plan" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Máximo de productos", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar enlace Ver todo", "default": true }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
