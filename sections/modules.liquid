<section id="{{ section.settings.anchor | default: 'suite' | handle }}" class="section">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="modules">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign url = block.settings.link
          if url == blank and p != blank
            assign url = p.url
          endif
          if url == blank
            assign url = '#contacto'
          endif
          assign items = block.settings.items | newline_to_br | split: '<br />'
        -%}
        <article class="card module" {{ block.shopify_attributes }}>
          <div class="module__top">
            <span class="module__icon">{% render 'icon', name: block.settings.icon %}</span>
            <span class="module__brand">{{ block.settings.tag | escape }}</span>
          </div>
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="module__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.items != blank -%}
            <ul class="checklist">
              {%- for item in items -%}
                {%- assign item = item | strip -%}
                {%- if item != blank -%}
                  <li>{% render 'icon', name: 'check-plain' %}<span>{{ item | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <div class="module__footer">
              <a class="link-arrow" href="{{ url }}">{{ block.settings.link_label | escape }}</a>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Módulos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla del menú", "info": "Para enlazar desde el menú con #suite.", "default": "suite" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "PLURA Suite" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tres módulos. Una sola operación." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Úsalos juntos o empieza por el que más necesites. Todos hablan el mismo idioma." }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Módulo",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "pos", "label": "Monitor (POS)" },
            { "value": "crm", "label": "Persona (CRM)" },
            { "value": "finance", "label": "Edificio (Finanzas)" },
            { "value": "plug", "label": "Conector" },
            { "value": "chart", "label": "Gráfico" },
            { "value": "nodes", "label": "Nodos" }
          ],
          "default": "pos"
        },
        { "type": "text", "id": "tag", "label": "Etiqueta", "default": "PLURA" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "POS" },
        { "type": "text", "id": "text", "label": "Descripción" },
        { "type": "textarea", "id": "items", "label": "Lista", "info": "Un elemento por línea." },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Me interesa" },
        { "type": "product", "id": "product", "label": "Producto de Shopify (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Vacío: el producto elegido o el formulario de contacto." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Módulos",
      "blocks": [
        { "type": "module", "settings": { "icon": "pos", "title": "POS", "text": "Vende rápido, en tienda o en movimiento.", "items": "Facturación ágil\nInventario sincronizado\nMúltiples sucursales y cajas\nCierres de caja en un clic" } },
        { "type": "module", "settings": { "icon": "crm", "title": "CRM", "text": "Convierte contactos en clientes fieles.", "items": "Pipeline visual de ventas\nHistorial 360° del cliente\nTareas y seguimientos\nCampañas y segmentación" } },
        { "type": "module", "settings": { "icon": "finance", "title": "Finanzas", "text": "Tus números claros, siempre al día.", "items": "Ingresos y gastos\nCuentas por cobrar y pagar\nFlujo de caja proyectado\nReportes listos para tu contador" } }
      ]
    }
  ]
}
{% endschema %}
