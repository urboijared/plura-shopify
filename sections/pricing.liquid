{%- liquid
  assign toggle_id = 'billing-' | append: section.id
  assign has_annual = false
  for block in section.blocks
    if block.settings.price_annual != blank
      assign has_annual = true
    endif
  endfor
-%}
<section id="{{ section.settings.anchor | default: 'precios' | handle }}" class="section pricing">
  <div class="page-width">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if has_annual -%}
      <div class="billing-toggle">
        <fieldset class="billing-toggle__group">
          <legend class="visually-hidden">{{ 'sections.pricing.billing' | t }}</legend>
          <input type="radio" id="{{ toggle_id }}-m" name="{{ toggle_id }}" value="monthly" checked>
          <label for="{{ toggle_id }}-m">{{ section.settings.monthly_label | escape }}</label>
          <input type="radio" id="{{ toggle_id }}-a" name="{{ toggle_id }}" value="annual">
          <label for="{{ toggle_id }}-a">
            {{- section.settings.annual_label | escape -}}
            {%- if section.settings.annual_save != blank -%}
              <span class="billing-toggle__save">{{ section.settings.annual_save | escape }}</span>
            {%- endif -%}
          </label>
        </fieldset>
      </div>
    {%- endif -%}

    <div class="plans" style="--plan-cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign url = block.settings.link
          if url == blank and p != blank
            assign url = p.url
          endif
          if url == blank
            assign url = '#contacto'
          endif
          assign items = block.settings.items | newline_to_br | split: '<br />'
        -%}
        <article class="card plan{% if block.settings.featured %} plan--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.featured and block.settings.badge != blank -%}
            <span class="tag tag--solid plan__badge">{{ block.settings.badge | escape }}</span>
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p class="plan__text">{{ block.settings.text | escape }}</p>

          <div class="plan__price price-monthly">
            <span class="plan__amount">{{ block.settings.price_monthly | escape }}</span>
            {%- if block.settings.period != blank -%}
              <span class="plan__period">{{ block.settings.period | escape }}</span>
            {%- endif -%}
          </div>
          {%- if has_annual -%}
            <div class="plan__price price-annual">
              <span class="plan__amount">{{ block.settings.price_annual | default: block.settings.price_monthly | escape }}</span>
              {%- if block.settings.period != blank and block.settings.price_annual != blank -%}
                <span class="plan__period">{{ block.settings.period | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.items != blank -%}
            <ul class="checklist">
              {%- for item in items -%}
                {%- assign item = item | strip -%}
                {%- if item != blank -%}
                  <li>{% render 'icon', name: 'check-plain' %}<span>{{ item | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a class="button button--full{% unless block.settings.featured %} button--secondary{% endunless %}" href="{{ url }}">
              {{- block.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Precios",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla del menú", "default": "precios" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Precios" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Planes que crecen contigo." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Precios en USD por empresa. Cambia o cancela cuando quieras." },
    { "type": "text", "id": "monthly_label", "label": "Texto mensual", "default": "Mensual" },
    { "type": "text", "id": "annual_label", "label": "Texto anual", "default": "Anual" },
    { "type": "text", "id": "annual_save", "label": "Ahorro anual", "default": "−15%" }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Plan" },
        { "type": "text", "id": "text", "label": "Para quién es" },
        { "type": "text", "id": "price_monthly", "label": "Precio mensual", "default": "$29" },
        { "type": "text", "id": "price_annual", "label": "Precio con pago anual", "info": "Precio mensual equivalente. Vacío: no cambia." },
        { "type": "text", "id": "period", "label": "Periodo", "default": "USD/mes" },
        { "type": "textarea", "id": "items", "label": "Incluye", "info": "Un elemento por línea." },
        { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Empezar" },
        { "type": "product", "id": "product", "label": "Producto de Shopify (opcional)", "info": "El botón lleva a la página del producto para comprarlo." },
        { "type": "url", "id": "link", "label": "Enlace del botón", "info": "Vacío: el producto elegido o el formulario de contacto." },
        { "type": "checkbox", "id": "featured", "label": "Destacar este plan", "default": false },
        { "type": "text", "id": "badge", "label": "Etiqueta del plan destacado", "default": "Más elegido" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Precios",
      "blocks": [
        { "type": "plan", "settings": { "title": "Inicial", "text": "Para negocios que están empezando a digitalizarse.", "price_monthly": "$29", "price_annual": "$25", "items": "1 módulo a elección\nHasta 3 usuarios\n1 sucursal\nSoporte por correo", "button_label": "Empezar" } },
        { "type": "plan", "settings": { "title": "Crecimiento", "text": "La suite completa para equipos en expansión.", "price_monthly": "$79", "price_annual": "$67", "items": "POS + CRM + Finanzas\nHasta 15 usuarios\nHasta 3 sucursales\nReportes avanzados\nSoporte prioritario", "button_label": "Solicitar demo", "featured": true } },
        { "type": "plan", "settings": { "title": "Empresa", "text": "Para operaciones con necesidades específicas.", "price_monthly": "A medida", "period": "", "items": "Usuarios y sucursales ilimitadas\nIntegraciones a medida\nGerente de cuenta dedicado\nSLA y capacitación", "button_label": "Hablar con ventas" } }
      ]
    }
  ]
}
{% endschema %}
