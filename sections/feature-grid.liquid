{%- liquid
  assign columns = section.blocks.size
  if columns > 4
    assign columns = 3
  endif
  if columns < 3
    assign columns = 3
  endif
-%}
<section class="section{% if section.settings.scheme == 'surface' %} section--surface{% elsif section.settings.scheme == 'dark' %} section--dark{% endif %}">
  <div class="page-width">
    <div class="section-header{% if section.settings.center %} section-header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="feature-grid feature-grid--{{ columns }}">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon bg-{{ block.settings.color }}">{% render 'icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Características",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Esquema",
      "options": [
        { "value": "ground", "label": "Fondo" },
        { "value": "surface", "label": "Superficie" },
        { "value": "dark", "label": "Oscuro" }
      ],
      "default": "ground"
    },
    { "type": "checkbox", "id": "center", "label": "Centrar encabezado", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué PLURA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Todo conectado desde el primer día" },
    { "type": "richtext", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Característica",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "nodes", "label": "Nodos" },
            { "value": "bolt", "label": "Rayo" },
            { "value": "shield", "label": "Escudo" },
            { "value": "chart", "label": "Gráfico" },
            { "value": "cloud", "label": "Nube" },
            { "value": "support", "label": "Soporte" },
            { "value": "download", "label": "Descarga" }
          ],
          "default": "nodes"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Color",
          "options": [
            { "value": "blue", "label": "Azul" },
            { "value": "amber", "label": "Ámbar" },
            { "value": "green", "label": "Verde" },
            { "value": "ink", "label": "Tinta" },
            { "value": "magenta", "label": "Magenta" }
          ],
          "default": "blue"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Característica" },
        { "type": "richtext", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Características",
      "blocks": [
        { "type": "feature", "settings": { "icon": "nodes", "color": "blue", "title": "Un solo sistema", "text": "<p>Tus datos de ventas, clientes y finanzas viven en el mismo lugar.</p>" } },
        { "type": "feature", "settings": { "icon": "bolt", "color": "amber", "title": "Activación inmediata", "text": "<p>Recibe tu acceso por correo apenas completes la compra.</p>" } },
        { "type": "feature", "settings": { "icon": "shield", "color": "green", "title": "Datos protegidos", "text": "<p>[Describe aquí tu política de seguridad y respaldo.]</p>" } }
      ]
    }
  ]
}
{% endschema %}
