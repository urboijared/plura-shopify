{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign interests = section.settings.interests | newline_to_br | split: '<br />'
  assign points = section.settings.points | newline_to_br | split: '<br />'
  assign email = section.settings.email | default: settings.contact_email
-%}
<section id="{{ section.settings.anchor | default: 'contacto' | handle }}" class="section contact">
  <div class="page-width split">
    <div class="split__sticky">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.points != blank -%}
        <ul class="checklist">
          {%- for item in points -%}
            {%- assign item = item | strip -%}
            {%- if item != blank -%}
              <li>{% render 'icon', name: 'check-plain' %}<span>{{ item | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if email != blank -%}
        <a class="contact__email" href="mailto:{{ email }}">{{ email }}</a>
      {%- endif -%}
    </div>

    <div class="card contact__form">
      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert">
            {{ 'contact.error' | t }}
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field-row">
          <div class="field">
            <label for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
            <input id="{{ form_id }}-name" type="text" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" required value="{{ form.name }}">
          </div>
          <div class="field">
            <label for="{{ form_id }}-email">{{ 'contact.email' | t }}</label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="{{ form_id }}-company">{{ 'contact.company' | t }}</label>
            <input id="{{ form_id }}-company" type="text" name="contact[{{ 'contact.company' | t }}]" autocomplete="organization">
          </div>
          <div class="field">
            <label for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
            <input id="{{ form_id }}-phone" type="tel" name="contact[{{ 'contact.phone_key' | t }}]" autocomplete="tel" value="{{ form.phone }}">
          </div>
        </div>
        {%- if section.settings.interests != blank -%}
          <div class="field">
            <label for="{{ form_id }}-interest">{{ 'contact.interest' | t }}</label>
            <select id="{{ form_id }}-interest" name="contact[{{ 'contact.interest' | t }}]">
              {%- for option in interests -%}
                {%- assign option = option | strip -%}
                {%- if option != blank -%}
                  <option value="{{ option | escape }}">{{ option | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        <div class="field">
          <label for="{{ form_id }}-body">{{ 'contact.message' | t }}</label>
          <textarea id="{{ form_id }}-body" name="contact[body]" rows="4">{{ form.body }}</textarea>
        </div>
        {%- if section.settings.consent != blank -%}
          <label class="checkbox">
            <input type="checkbox" name="contact[{{ 'contact.consent_key' | t }}]" value="{{ 'contact.yes' | t }}" required>
            <span>{{ section.settings.consent | escape }}</span>
          </label>
        {%- endif -%}
        <button type="submit" class="button button--full button--lg">{{ section.settings.button_label | escape }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formulario de contacto",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla del menú", "default": "contacto" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Contacto" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Hablemos de tu empresa." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Déjanos tus datos y te contactamos en menos de 24 horas hábiles para agendar una demo personalizada." },
    { "type": "textarea", "id": "points", "label": "Puntos", "info": "Uno por línea.", "default": "Demo de 30 minutos con tus casos reales\nPropuesta según tu tamaño y necesidades\nSin compromiso" },
    { "type": "text", "id": "email", "label": "Correo visible", "info": "Vacío: el correo de la configuración del tema." },
    { "type": "textarea", "id": "interests", "label": "Opciones de interés", "info": "Una por línea.", "default": "PLURA Suite completa\nPLURA POS\nPLURA CRM\nPLURA Finanzas" },
    { "type": "text", "id": "consent", "label": "Texto de consentimiento", "default": "Acepto que PLURA me contacte sobre sus servicios." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Solicitar demo" }
  ],
  "presets": [{ "name": "Formulario de contacto" }]
}
{% endschema %}
