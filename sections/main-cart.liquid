<section class="section section--tight">
  <div class="page-width">
    <div class="section-header">
      <h1>{{ 'cart.title' | t }}</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart" novalidate>
        <div>
          <ul class="cart-items">
            {%- for item in cart.items -%}
              {%- capture color -%}{% render 'product-color', product: item.product %}{%- endcapture -%}
              <li class="cart-item">
                <div class="cart-item__media bg-{{ color }}">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt, width: 88, height: 88 }}
                  {%- else -%}
                    {% render 'isotipo', variant: 'mono', width: 44 %}
                  {%- endif -%}
                </div>
                <div>
                  <h2 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-item__meta">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation -%}
                    <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}
                  {%- for property in item.properties -%}
                    {%- unless property.last == blank or property.first contains '_' -%}
                      <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
                    {%- endunless -%}
                  {%- endfor -%}
                  <div class="cart-item__controls">
                    <div class="quantity">
                      <label class="visually-hidden" for="Quantity-{{ item.key }}">{{ 'products.quantity' | t }}</label>
                      <input id="Quantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                    </div>
                    <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                    <span class="price cart-item__price">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s class="price__compare">{{ item.original_line_price | money }}</s>
                      {%- endif -%}
                      <span class="price__current">{{ item.final_line_price | money }}</span>
                    </span>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
          <div class="button-row" style="margin-top: 24px">
            <button type="submit" name="update" class="button button--secondary">{{ 'cart.update' | t }}</button>
            <a class="link-arrow" href="{{ routes.all_products_collection_url }}" style="align-self: center">{{ 'cart.continue' | t }}</a>
          </div>
        </div>

        <aside class="cart-summary" aria-label="{{ 'cart.summary' | t }}">
          {%- if section.settings.show_note -%}
            <div class="field">
              <label for="CartNote">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span class="price">{{ cart.items_subtotal_price | money }}</span>
          </div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row">
              <span>{{ discount.title | escape }}</span>
              <span class="price">-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-summary__row cart-summary__total">
            <span>{{ 'cart.total' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="cart-summary__note">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons and section.settings.show_additional_checkout -%}
            <div style="margin-top: 12px">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </aside>
      </form>
    {%- else -%}
      <div class="empty-state">
        {% render 'isotipo', width: 120 %}
        <p class="lead">{{ 'cart.empty' | t }}</p>
        <div class="button-row">
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrito",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Permitir nota del pedido", "default": false },
    { "type": "checkbox", "id": "show_additional_checkout", "label": "Mostrar botones de pago rápido", "default": true }
  ]
}
{% endschema %}
