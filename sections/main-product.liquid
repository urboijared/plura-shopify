{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}
<section class="section section--tight">
  <div class="page-width product">
    <div class="product__media">
      {%- if product.media.size > 0 -%}
        <ul class="product__media-list">
          {%- for media in product.media -%}
            <li class="product__media-item">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.first
                      assign loading = 'eager'
                    endif
                  -%}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: loading,
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      widths: '600, 900, 1200, 1400',
                      alt: media.alt
                  }}
                {%- when 'video', 'external_video' -%}
                  {{ media | media_tag: image_size: '1400x' }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="product__placeholder"><div class="placeholder">{% render 'isotipo', width: 160 %}</div></div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>
              {{- block.settings.text | default: product.type | escape -}}
            </span>

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div data-price-for="{{ form_id }}" class="price{% if current_variant.compare_at_price > current_variant.price %} price--sale{% endif %}" {{ block.shopify_attributes }}>
              <span class="price__current">{{ current_variant.price | money }}</span>
              {%- if current_variant.compare_at_price > current_variant.price -%}
                <s class="price__compare">{{ current_variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product__form', data-product-form: form_id -%}
                {%- unless product.has_only_default_variant -%}
                  <fieldset class="variant-options">
                    <legend>{{ block.settings.variant_label | default: product.options.first }}</legend>
                    <div class="variant-options__list">
                      {%- for variant in product.variants -%}
                        <div class="variant-option">
                          <input
                            type="radio"
                            id="{{ form_id }}-{{ variant.id }}"
                            name="id"
                            value="{{ variant.id }}"
                            {% if variant.id == current_variant.id %}checked{% endif %}
                            {% unless variant.available %}disabled{% endunless %}
                          >
                          <label for="{{ form_id }}-{{ variant.id }}">
                            {{ variant.title | escape }}
                            <span class="variant-option__price">{{ variant.price | money }}</span>
                          </label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                {%- endunless -%}

                <script type="application/json" data-variants>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id | json }},
                        "available": {{ variant.available | json }},
                        "price": {{ variant.price | money | strip_html | json }},
                        "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | json }}{% else %}null{% endif %}
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>

                {%- if block.settings.show_quantity -%}
                  <div class="field">
                    <label for="{{ form_id }}-quantity">{{ 'products.quantity' | t }}</label>
                    <input id="{{ form_id }}-quantity" type="number" name="quantity" value="1" min="1" inputmode="numeric" style="max-width: 140px">
                  </div>
                {%- endif -%}

                <button
                  type="submit"
                  name="add"
                  class="button button--full"
                  data-label-available="{{ 'products.add_to_cart' | t }}"
                  data-label-sold-out="{{ 'products.sold_out' | t }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span>
                    {%- if current_variant.available -%}
                      {{ 'products.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'perks' -%}
            <ul class="card checklist product__perks" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign key = 'perk_' | append: i -%}
                {%- if block.settings[key] != blank -%}
                  <li>{% render 'icon', name: 'check-plain' %}<span>{{ block.settings[key] | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            <div class="accordion" style="margin-top: 32px" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ block.settings.heading | escape }}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                </div>
              </details>
            </div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "tag": "div",
  "blocks": [
    { "type": "@app" },
    {
      "type": "eyebrow",
      "name": "Antetítulo",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "info": "Si lo dejas vacío se usa el tipo de producto." }
      ]
    },
    { "type": "title", "name": "Título", "limit": 1 },
    { "type": "price", "name": "Precio", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "variant_label", "label": "Título de las opciones", "default": "Elige tu plan" },
        { "type": "checkbox", "id": "show_quantity", "label": "Mostrar cantidad (licencias)", "default": false },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón de pago rápido", "default": true }
      ]
    },
    {
      "type": "perks",
      "name": "Beneficios",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Beneficio 1", "default": "Acceso inmediato después de la compra" },
        { "type": "text", "id": "perk_2", "label": "Beneficio 2", "default": "Se conecta con el resto de PLURA Suite" },
        { "type": "text", "id": "perk_3", "label": "Beneficio 3", "default": "[Soporte incluido: describe el alcance]" },
        { "type": "text", "id": "perk_4", "label": "Beneficio 4" }
      ]
    },
    { "type": "description", "name": "Descripción", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Requisitos del sistema" },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "Contenido de una página" }
      ]
    }
  ]
}
{% endschema %}
