<section class="section">
  <div class="page-width empty-state">
    {% render 'isotipo', variant: 'glow', width: 180 %}
    <span class="eyebrow">404</span>
    <h1>{{ 'templates.404.title' | t }}</h1>
    <p class="lead">{{ 'templates.404.subtext' | t }}</p>
    <div class="button-row">
      <a class="button" href="{{ routes.root_url }}">{{ 'templates.404.home' | t }}</a>
      <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página no encontrada",
  "tag": "div"
}
{% endschema %}
