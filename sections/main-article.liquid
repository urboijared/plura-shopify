<section class="section section--tight">
  <div class="page-width">
    <article class="article">
      <p class="article__meta">
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a> ·
        {{ article.published_at | time_tag: format: 'date' }}
      </p>
      <h1>{{ article.title | escape }}</h1>
      {%- if article.image -%}
        <div class="article__image">
          {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 800px) 760px, 100vw', widths: '600, 900, 1200, 1600' }}
        </div>
      {%- endif -%}
      <div class="rte">{{ article.content }}</div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Artículo",
  "tag": "div"
}
{% endschema %}
