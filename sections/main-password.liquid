<div class="password">
  {% render 'isotipo', width: 120 %}
  <span class="wordmark">plura.</span>
  {%- if section.settings.text != blank -%}
    <p class="lead">{{ section.settings.text | escape }}</p>
  {%- elsif shop.password_message != blank -%}
    <p class="lead">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="prelanzamiento">
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter">
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
        <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details>
    <summary class="muted" style="cursor: pointer">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="form-message form-message--error" role="alert">{{ 'password.error' | t }}</p>
      {%- endif -%}
      <div class="field" style="margin-top: 16px">
        <label for="StorePassword">{{ 'password.label' | t }}</label>
        <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="button button--full">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Contraseña",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "text", "label": "Mensaje", "default": "Muy pronto. Déjanos tu correo y te avisamos del lanzamiento." }
  ]
}
{% endschema %}
