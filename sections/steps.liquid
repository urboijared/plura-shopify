<section class="section">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Cómo funciona",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Cómo funciona" },
    { "type": "text", "id": "heading", "label": "Título", "default": "De la demo a operar en días, no meses." },
    { "type": "text", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Paso" },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cómo funciona",
      "blocks": [
        { "type": "step", "settings": { "title": "Agenda una demo", "text": "Conocemos tu negocio y te mostramos PLURA con tus casos reales." } },
        { "type": "step", "settings": { "title": "Configuramos contigo", "text": "Migramos tus datos, creamos usuarios y ajustamos la plataforma." } },
        { "type": "step", "settings": { "title": "Empieza a crecer", "text": "Opera con todo conectado y recibe acompañamiento continuo." } }
      ]
    }
  ]
}
{% endschema %}
