{%- assign email = section.settings.email | default: settings.contact_email -%}
<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {% render 'brand' %}
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        {%- if email != blank -%}
          <a class="contact__email" href="mailto:{{ email }}">{{ email }}</a>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', id: 'FooterNewsletter', style: 'width: 100%' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
            {%- elsif form.errors -%}
              <p class="form-message form-message--error" role="alert">{{ form.errors.messages.email }}</p>
            {%- endif -%}
            <div class="newsletter">
              <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
              <input id="FooterNewsletterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
              <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
            </div>
          {%- endform -%}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.rights' | t }}</span>

      {%- liquid
        assign has_social = false
        if settings.social_instagram != blank or settings.social_linkedin != blank or settings.social_x != blank or settings.social_youtube != blank
          assign has_social = true
        endif
      -%}
      {%- if has_social -%}
        <ul class="social-list">
          {%- if settings.social_instagram != blank -%}
            <li><a class="icon-button" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>
          {%- endif -%}
          {%- if settings.social_linkedin != blank -%}
            <li><a class="icon-button" href="{{ settings.social_linkedin }}" target="_blank" rel="noopener">{% render 'icon', name: 'linkedin' %}<span class="visually-hidden">LinkedIn</span></a></li>
          {%- endif -%}
          {%- if settings.social_x != blank -%}
            <li><a class="icon-button" href="{{ settings.social_x }}" target="_blank" rel="noopener">{% render 'icon', name: 'x' %}<span class="visually-hidden">X</span></a></li>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <li><a class="icon-button" href="{{ settings.social_youtube }}" target="_blank" rel="noopener">{% render 'icon', name: 'youtube' %}<span class="visually-hidden">YouTube</span></a></li>
          {%- endif -%}
        </ul>
      {%- else -%}
        <span class="wordmark" aria-hidden="true">plura.</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Frase", "default": "Software que facilita el crecimiento de tu empresa." },
    { "type": "text", "id": "email", "label": "Correo", "info": "Vacío: el correo de la configuración del tema." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar suscripción", "default": false }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de enlaces",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Producto" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
