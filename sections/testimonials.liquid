<section class="section">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="card quote" {{ block.shopify_attributes }}>
          <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption>
            <span class="quote__avatar">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', width: 36, height: 36, alt: '' }}
              {%- endif -%}
            </span>
            <span>
              {{ block.settings.name | escape }}
              <span class="quote__role">{{ block.settings.role | escape }}</span>
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Clientes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen quienes ya usan PLURA." }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonio",
      "limit": 9,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Cita", "default": "[Testimonio del cliente]" },
        { "type": "text", "id": "name", "label": "Nombre", "default": "[Nombre del cliente]" },
        { "type": "text", "id": "role", "label": "Cargo y empresa", "default": "[Cargo · Empresa]" },
        { "type": "image_picker", "id": "image", "label": "Foto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonios",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Por fin tenemos ventas, clientes y caja en el mismo lugar. Cerramos el mes en horas, no en días.", "name": "[Nombre del cliente]", "role": "[Cargo · Empresa]" } },
        { "type": "quote", "settings": { "quote": "El CRM nos ayudó a ordenar el seguimiento comercial. Ahora ningún lead se queda sin respuesta.", "name": "[Nombre del cliente]", "role": "[Cargo · Empresa]" } },
        { "type": "quote", "settings": { "quote": "La implementación fue rápida y el equipo de soporte siempre responde. Se siente como un socio.", "name": "[Nombre del cliente]", "role": "[Cargo · Empresa]" } }
      ]
    }
  ]
}
{% endschema %}
