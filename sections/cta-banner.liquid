<section class="section">
  <div class="page-width">
    <div class="card cta-banner">
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="lead">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <div class="button-row">
          {%- if section.settings.button_label != blank -%}
            <a class="button button--lg" href="{{ section.settings.button_link | default: routes.root_url }}">
              {{- section.settings.button_label | escape }}
              <span class="button__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a class="button button--lg button--secondary" href="{{ section.settings.button2_link | default: routes.root_url }}">
              {{- section.settings.button2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      {% render 'isotipo', width: 160 %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Llamado a la acción",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Listo para ordenar tu operación?" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Agenda una demo y te mostramos PLURA con los casos de tu negocio." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Solicitar demo gratis" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button2_label", "label": "Botón secundario", "default": "Ver precios" },
    { "type": "url", "id": "button2_link", "label": "Enlace del botón secundario" }
  ],
  "presets": [{ "name": "Llamado a la acción" }]
}
{% endschema %}
