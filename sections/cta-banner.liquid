<section class="section">
  <div class="page-width">
    <div class="cta-banner section--dark">
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="lead rte" style="margin-bottom: 32px">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="button-row">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_label != blank -%}
            <a class="button button--secondary" href="{{ section.settings.button2_link | default: '#' }}">
              {{- section.settings.button2_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
      {% render 'isotipo', variant: 'glow', width: 220 %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Llamado a la acción",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Empieza hoy con PLURA" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Activa tu primer módulo en minutos y suma los demás cuando los necesites.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Ver planes" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button2_label", "label": "Botón secundario", "default": "Hablar con ventas" },
    { "type": "url", "id": "button2_link", "label": "Enlace del botón secundario" }
  ],
  "presets": [{ "name": "Llamado a la acción" }]
}
{% endschema %}
