{%- liquid
  assign cta_link = section.settings.cta_link | default: '#contacto'
  assign show_lang = false
  if section.settings.show_language and localization.available_languages.size > 1
    assign show_lang = true
  endif
-%}
<header class="site-header">
  <div class="page-width site-header__inner">
    {% render 'brand' %}

    <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      {%- if show_lang -%}
        {%- form 'localization', class: 'lang-switch' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- for language in localization.available_languages -%}
            {%- unless language.iso_code == localization.language.iso_code -%}
              <button type="submit" name="language_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}">
                {{- language.iso_code | upcase -}}
                <span class="visually-hidden">{{ language.endonym_name }}</span>
              </button>
              {%- break -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <a class="icon-button" href="{{ routes.search_url }}">
          {% render 'icon', name: 'search' %}
          <span class="visually-hidden">{{ 'general.search' | t }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart == 'always' or cart.item_count > 0 -%}
        <a class="icon-button" href="{{ routes.cart_url }}">
          {% render 'icon', name: 'cart' %}
          <span class="visually-hidden">{{ 'cart.title' | t }}</span>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
            <span class="visually-hidden">{{ 'cart.count' | t: count: cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="button" href="{{ cta_link }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}

      {%- if section.settings.menu.links.size > 0 -%}
        <details class="mobile-menu" data-mobile-menu>
          <summary class="icon-button icon-button--outline">
            <span class="mobile-menu__icon-open">{% render 'icon', name: 'menu' %}</span>
            <span class="mobile-menu__icon-close">{% render 'icon', name: 'close' %}</span>
            <span class="visually-hidden">{{ 'sections.header.menu' | t }}</span>
          </summary>
          <div class="mobile-menu__panel">
            <nav aria-label="{{ 'sections.header.menu' | t }}">
              <ul>
                {%- for link in section.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          </div>
        </details>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Encabezado",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Agendar demo" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón", "info": "Si lo dejas vacío lleva al formulario de contacto de la portada." },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Mostrar cambio de idioma",
      "info": "Aparece cuando la tienda tiene más de un idioma publicado.",
      "default": true
    },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar búsqueda", "default": false },
    {
      "type": "select",
      "id": "show_cart",
      "label": "Icono del carrito",
      "options": [
        { "value": "items", "label": "Solo cuando hay productos" },
        { "value": "always", "label": "Siempre" }
      ],
      "default": "items"
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
