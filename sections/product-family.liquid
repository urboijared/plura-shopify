<section id="familia" class="section{% if section.settings.scheme == 'surface' %} section--surface{% elsif section.settings.scheme == 'dark' %} section--dark{% endif %}">
  <div class="page-width family__grid">
    <div class="family__intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <ul class="family__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign name = block.settings.name
          if name == blank and p != blank
            assign name = p.title
          endif
          assign url = block.settings.link
          if url == blank and p != blank
            assign url = p.url
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          {%- if url != blank -%}
            <a class="pill bg-{{ block.settings.color }}" href="{{ url }}">
          {%- else -%}
            <div class="pill bg-{{ block.settings.color }}">
          {%- endif -%}
              <span class="pill__dot" aria-hidden="true"></span>
              <span class="pill__name">
                {{- name | escape -}}
                {%- if block.settings.text != blank -%}
                  <span class="pill__text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
              {%- if url != blank -%}<span class="pill__arrow" aria-hidden="true">→</span>{%- endif -%}
          {%- if url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Familia de productos",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Esquema",
      "options": [
        { "value": "ground", "label": "Fondo" },
        { "value": "surface", "label": "Superficie" },
        { "value": "dark", "label": "Oscuro" }
      ],
      "default": "surface"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "La familia PLURA" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una familia, un solo sistema." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cada módulo funciona solo y se conecta con los demás. Empieza por lo que más necesitas hoy.</p>" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todos los planes" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "limit": 8,
      "settings": [
        { "type": "product", "id": "product", "label": "Producto de Shopify" },
        { "type": "text", "id": "name", "label": "Nombre", "info": "Si lo dejas vacío se usa el nombre del producto." },
        { "type": "text", "id": "text", "label": "Descripción corta" },
        { "type": "url", "id": "link", "label": "Enlace", "info": "Si lo dejas vacío se usa la página del producto." },
        {
          "type": "select",
          "id": "color",
          "label": "Color",
          "options": [
            { "value": "blue", "label": "Azul" },
            { "value": "amber", "label": "Ámbar" },
            { "value": "green", "label": "Verde" },
            { "value": "ink", "label": "Tinta" },
            { "value": "magenta", "label": "Magenta" }
          ],
          "default": "blue"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Familia de productos",
      "blocks": [
        { "type": "product", "settings": { "name": "pos", "text": "[Describe PLURA POS en una línea]", "color": "blue" } },
        { "type": "product", "settings": { "name": "crm", "text": "[Describe PLURA CRM en una línea]", "color": "amber" } },
        { "type": "product", "settings": { "name": "finanzas", "text": "[Describe PLURA Finanzas en una línea]", "color": "green" } },
        { "type": "product", "settings": { "name": "suite", "text": "[Describe PLURA Suite en una línea]", "color": "ink" } },
        { "type": "product", "settings": { "name": "connect", "text": "[Describe PLURA Connect en una línea]", "color": "magenta" } }
      ]
    }
  ]
}
{% endschema %}
