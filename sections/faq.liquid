<section id="{{ section.settings.anchor | default: 'faq' | handle }}" class="section">
  <div class="page-width split">
    <div class="split__sticky">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla del menú", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Resolvemos tus dudas." },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "open_first", "label": "Abrir la primera pregunta", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Pregunta" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [
        { "type": "question", "settings": { "question": "¿Puedo contratar solo un módulo?", "answer": "<p>Sí. Empieza con POS, CRM o Finanzas y suma los demás cuando los necesites.</p>" } },
        { "type": "question", "settings": { "question": "¿Necesito instalar algo?", "answer": "<p>No. PLURA funciona en la nube desde cualquier navegador.</p>" } },
        { "type": "question", "settings": { "question": "¿Cuánto tarda la implementación?", "answer": "<p>[Indica el tiempo habitual de implementación.]</p>" } },
        { "type": "question", "settings": { "question": "¿Mis datos están seguros?", "answer": "<p>[Describe cifrado, respaldos y control de accesos.]</p>" } },
        { "type": "question", "settings": { "question": "¿Ofrecen capacitación y soporte?", "answer": "<p>[Describe el acompañamiento incluido.]</p>" } },
        { "type": "question", "settings": { "question": "¿Puedo cancelar cuando quiera?", "answer": "<p>[Resume tu política de cancelación.]</p>" } }
      ]
    }
  ]
}
{% endschema %}
