<section class="section{% if section.settings.scheme == 'surface' %} section--surface{% elsif section.settings.scheme == 'dark' %} section--dark{% endif %}">
  <div class="page-width">
    <div class="family__grid">
      <div class="family__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="lead rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="accordion">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="accordion__content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Esquema",
      "options": [
        { "value": "ground", "label": "Fondo" },
        { "value": "surface", "label": "Superficie" },
        { "value": "dark", "label": "Oscuro" }
      ],
      "default": "surface"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Preguntas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "open_first", "label": "Abrir la primera pregunta", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Pregunta" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes",
      "blocks": [
        { "type": "question", "settings": { "question": "¿Cómo recibo el software después de comprar?", "answer": "<p>[Explica cómo se entrega: descarga, licencia por correo o acceso a la cuenta.]</p>" } },
        { "type": "question", "settings": { "question": "¿Puedo combinar varios módulos?", "answer": "<p>[Explica cómo se conectan POS, CRM, Finanzas, Suite y Connect.]</p>" } },
        { "type": "question", "settings": { "question": "¿Qué medios de pago aceptan?", "answer": "<p>[Indica los medios de pago disponibles.]</p>" } },
        { "type": "question", "settings": { "question": "¿Puedo cancelar o pedir un reembolso?", "answer": "<p>[Resume tu política de reembolso y enlaza la página completa.]</p>" } }
      ]
    }
  ]
}
{% endschema %}
