{%- comment -%}
  Precio de un producto o variante. Parámetros: product, variant (opcional).
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  {%- if product.price_varies and variant == blank -%}
    <span class="price__current">{{ 'products.price.from' | t: price: product.price_min | money }}</span>
  {%- else -%}
    <span class="price__current">{{ target.price | money }}</span>
    {%- if on_sale -%}
      <s class="price__compare">{{ target.compare_at_price | money }}</s>
    {%- endif -%}
  {%- endif -%}
  {%- if target.selling_plan_allocation -%}
    <span class="price__note">{{ target.selling_plan_allocation.selling_plan.name }}</span>
  {%- endif -%}
</div>
