{%- comment -%}
  Tarjeta de producto. Parámetro: product.
{%- endcomment -%}
{%- capture color -%}{% render 'product-color', product: product %}{%- endcapture -%}
<article class="product-card product-card--{{ color }}">
  <a class="product-card__link" href="{{ product.url }}">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
            widths: '360, 540, 720, 900',
            alt: product.featured_media.alt
        }}
      {%- else -%}
        <div class="product-card__placeholder">
          {%- if color == 'amber' -%}
            {% render 'isotipo', variant: 'mono', width: 96, class: 'isotipo--ink' %}
          {%- else -%}
            {% render 'isotipo', variant: 'mono', width: 96, class: 'isotipo--white' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="product-card__body">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
      {%- if product.description != blank -%}
        <p class="product-card__excerpt">{{ product.description | strip_html | truncatewords: 16 }}</p>
      {%- endif -%}
      {% render 'price', product: product %}
    </div>
  </a>
</article>
