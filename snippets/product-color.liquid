{%- comment -%}
  Devuelve el nombre del color de marca de un producto: blue, amber, green, ink o magenta.
  Prioridad: metacampo custom.color_plura > etiqueta "color:<nombre>" > handle (pos, crm, finanzas, suite, connect).
  Parámetro: product
{%- endcomment -%}
{%- liquid
  assign result = ''
  assign meta = product.metafields.custom.color_plura.value | downcase
  if meta != blank
    assign result = meta
  endif

  if result == blank
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'color:'
        assign result = tag_down | remove: 'color:' | strip
        break
      endif
    endfor
  endif

  if result == blank
    if product.handle contains 'pos'
      assign result = 'blue'
    elsif product.handle contains 'crm'
      assign result = 'amber'
    elsif product.handle contains 'finanzas'
      assign result = 'green'
    elsif product.handle contains 'suite'
      assign result = 'ink'
    elsif product.handle contains 'connect'
      assign result = 'magenta'
    else
      assign result = 'blue'
    endif
  endif

  case result
    when 'azul'
      assign result = 'blue'
    when 'ambar', 'ámbar', 'naranja'
      assign result = 'amber'
    when 'verde'
      assign result = 'green'
    when 'tinta', 'negro'
      assign result = 'ink'
    when 'magenta', 'rosa'
      assign result = 'magenta'
  endcase
-%}
{{- result -}}
