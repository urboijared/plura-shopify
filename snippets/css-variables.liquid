{% style %}
  @font-face {
    font-family: 'Nunito';
    src: url('{{ 'nunito-latin-wght.woff2' | asset_url }}') format('woff2-variations');
    font-weight: 200 1000;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('{{ 'ibm-plex-mono-500.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --color-ink: {{ settings.color_ink }};
    --color-ground: {{ settings.color_ground }};
    --color-surface: {{ settings.color_surface }};
    --color-night: {{ settings.color_night }};
    --color-muted: {{ settings.color_muted }};
    --color-line: {{ settings.color_line }};
    --color-blue: {{ settings.color_blue }};
    --color-magenta: {{ settings.color_magenta }};
    --color-green: {{ settings.color_green }};
    --color-amber: {{ settings.color_amber }};
    --color-accent: var(--color-{{ settings.color_accent }});

    --font-display: 'Nunito', ui-rounded, 'SF Pro Rounded', system-ui, sans-serif;
    --font-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;

    --page-width: {{ settings.page_width }}px;
    --radius: {{ settings.radius }}px;
    --radius-pill: 999px;
  }
{% endstyle %}
