      { "type": "color", "id": "color_amber", "label": "Ámbar (CRM)", "default": "#E39B22" },
      { "type": "color", "id": "color_green", "label": "Verde (Finanzas)", "default": "#136F4A" },
      { "type": "color", "id": "color_magenta", "label": "Magenta (Connect)", "default": "#C8235A" },
      {
        "type": "select",
        "id": "color_accent",
