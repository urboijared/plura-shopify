      { "type": "color", "id": "color_surface", "label": "Superficie (tarjetas)", "default": "#FFFFFF" },
      { "type": "color", "id": "color_night", "label": "Fondo oscuro", "default": "#0C0E14" },
      { "type": "color", "id": "color_muted", "label": "Texto secundario", "default": "#4F5465" },
      { "type": "color", "id": "color_line", "label": "Bordes", "default": "#E1E4EA" },
      { "type": "header", "content": "Familia de productos" },
