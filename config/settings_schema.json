        "options": [
          { "value": "blue", "label": "Azul" },
          { "value": "magenta", "label": "Magenta" },
          { "value": "green", "label": "Verde" },
          { "value": "ink", "label": "Tinta" }
        ],
        "default": "blue"
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Ancho máximo de página", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1240 },
      { "type": "range", "id": "radius", "label": "Radio de esquinas", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 20 }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
