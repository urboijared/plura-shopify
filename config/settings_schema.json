[
  {
    "name": "theme_info",
    "theme_name": "PLURA",
    "theme_version": "2.0.0",
    "theme_author": "PLURA",
    "theme_documentation_url": "https://github.com/urboijared/plura-shopify",
    "theme_support_url": "https://github.com/urboijared/plura-shopify"
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "select",
        "id": "color_mode",
        "label": "Modo de color",
        "options": [
          { "value": "light", "label": "Claro" },
          { "value": "dark", "label": "Oscuro" },
          { "value": "auto", "label": "Automático (según el sistema del visitante)" }
        ],
        "default": "light"
      },
      { "type": "header", "content": "Modo claro" },
      { "type": "color", "id": "light_bg", "label": "Fondo", "default": "#FAFAFA" },
      { "type": "color", "id": "light_surface", "label": "Tarjetas", "default": "#FFFFFF" },
      { "type": "color", "id": "light_ink", "label": "Texto", "default": "#0A0A0A" },
      { "type": "color", "id": "light_muted", "label": "Texto secundario", "default": "#5C5C66" },
      { "type": "color", "id": "light_line", "label": "Bordes", "default": "#E7E7EB" },
      { "type": "color", "id": "light_accent", "label": "Acento", "default": "#5B4BF5" },
      { "type": "header", "content": "Modo oscuro" },
      { "type": "color", "id": "dark_bg", "label": "Fondo", "default": "#0A0A0B" },
      { "type": "color", "id": "dark_surface", "label": "Tarjetas", "default": "#131315" },
      { "type": "color", "id": "dark_ink", "label": "Texto", "default": "#F4F4F5" },
      { "type": "color", "id": "dark_muted", "label": "Texto secundario", "default": "#A1A1AA" },
      { "type": "color", "id": "dark_line", "label": "Bordes", "default": "#26262B" },
      { "type": "color", "id": "dark_accent", "label": "Acento", "default": "#8B7DF8" }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Ancho máximo de página", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1160 },
      { "type": "range", "id": "radius", "label": "Radio de tarjetas", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 16 }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (opcional)",
        "info": "Si lo dejas vacío se usa el isotipo y el texto plura."
      },
      { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 60, "max": 240, "step": 4, "unit": "px", "default": 96 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Si lo dejas vacío se usa el isotipo." }
    ]
  },
  {
    "name": "Contacto y redes",
    "settings": [
      { "type": "text", "id": "contact_email", "label": "Correo de contacto", "default": "hola@plura.example" },
      { "type": "text", "id": "social_instagram", "label": "Instagram" },
      { "type": "text", "id": "social_linkedin", "label": "LinkedIn" },
      { "type": "text", "id": "social_x", "label": "X" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" }
    ]
  }
]
